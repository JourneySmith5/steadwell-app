DATABASE_URL="postgresql://user:password@host:5432/dbname"   # e.g. a Supabase/Neon connection string
SESSION_SECRET="replace-with-output-of-openssl-rand-base64-32"
APP_URL="http://localhost:3000"

# Two placeholders the Financial Foundation payment/Stripe pieces below fill
# straight into the agreement text (src/lib/agreementContent.ts) — set these
# for real before a real client sees the agreement.
COACH_LEGAL_NAME=""   # e.g. "Jane Doe, d/b/a Steadwell"
GOVERNING_COUNTY=""   # the Texas county for the agreement's venue clause

# Real Stripe integration IS wired up (checkout, discount codes, webhook —
# see src/lib/checkout.ts and src/app/api/webhooks/stripe/route.ts) but runs
# in a clearly-labeled test mode until both of these are set. Point Stripe's
# webhook config at <APP_URL>/api/webhooks/stripe. See README "Before this
# goes live".
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
EMAIL_FROM="coach@yourdomain.com"   # must be a domain you've verified in Resend

# Real transactional email via Resend (src/lib/email.ts) — falls back to a
# console.log stand-in until this is set, same pattern as Stripe above.
RESEND_API_KEY=""

# Shared secret Vercel Cron sends as a Bearer token when it calls
# /api/cron/offboarding-sweep on a schedule (see vercel.json). Generate a
# random value and set the same one here and in Vercel's env vars.
CRON_SECRET=""

# Real file storage for Foundation Intake → Statements (src/app/portal/
# (protected)/foundation/statements). Without this, uploading a statement
# will throw — there's no dev-mode stand-in for real file storage the way
# there is for Stripe/Resend, since there's nothing meaningful to fake.
# In Vercel: Storage tab → Create Database → Blob → connect it to this
# project, and Vercel sets this env var for you automatically. For local
# dev, copy that same value here (or run `vercel env pull`).
BLOB_READ_WRITE_TOKEN=""
